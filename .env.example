# ---- Local development ----
# Copy this file to .env and adjust as needed.
# Local Express reads certs from the ./certs folder by default.

PORT=3000
CORS_ORIGIN=http://localhost:5173

# Optional: override cert paths (defaults: ./certs/*)
# QZ_CERT_FILE=./certs/digital-certificate.txt
# QZ_PRIVATE_KEY_FILE=./certs/private-key.pem

# Optional: a logo image URL to print on the receipt.
# LOGO_URL=https://example.com/your-logo.png


# ---- Vercel (set these in Vercel → Settings → Environment Variables) ----
# QZ_CERTIFICATE=<contents of digital-certificate.txt>
# QZ_PRIVATE_KEY=<contents of private-key.pem>
# LOGO_URL=https://example.com/your-logo.png